<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.SmartVehicleTelemetryDashboard_Mobile" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#0F1014</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:colorAccent">#00B4D8</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>

        <!-- Bỏ logo mặc định Android 12+ và đồng bộ màu nền -->
        <item name="android:windowSplashScreenBackground" tools:targetApi="s">#0F1014</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="s">@android:color/transparent</item>
    </style>
</resources>
